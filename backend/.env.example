# JourneyIt Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual API keys and credentials.
# NEVER commit the .env file to version control - it contains sensitive data!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default for development) - already configured
DATABASE_URL=sqlite:///./journeyit.db

# PostgreSQL (for production) - uncomment and configure when ready
# DATABASE_URL=postgresql://user:password@localhost:5432/journeyit

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# Secret key for signing JWT tokens - CHANGE THIS IN PRODUCTION!
# Generate a new one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=journeyit-dev-secret-change-in-production-abc123xyz

# Access token expiry (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiry (days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================

# =============================================================================
# EXTERNAL API KEYS - PRIMARY & SECONDARY (FALLBACK)
# =============================================================================
# Format: Each service has PRIMARY and SECONDARY keys
# If PRIMARY fails (rate limit, invalid, etc.), system automatically tries SECONDARY
# 
# Get your API keys at:
# - RapidAPI: https://rapidapi.com/hub (for Booking.com)
# - AviationStack: https://aviationstack.com
# - Gemini: https://aistudio.google.com/app/apikey
# - SearchAPI: https://www.searchapi.io/

# RapidAPI Keys (Booking.com hotel search)
RAPIDAPI_KEY=
RAPIDAPI_KEY_SECONDARY=

# AviationStack Keys (flight data)
AVIATIONSTACK_KEY=
AVIATIONSTACK_KEY_SECONDARY=

# Google Gemini Keys (AI chat)
GEMINI_KEY=
GEMINI_KEY_SECONDARY=

# SearchAPI.io Keys (Google Hotels search)
SEARCHAPI_KEY=
SEARCHAPI_KEY_SECONDARY=

# =============================================================================
# EMAIL CONFIGURATION (for OTP verification)
# =============================================================================
# Gmail SMTP settings for sending OTP emails
# Required for email verification feature to work

# Your Gmail address
EMAIL_USER=

# Your Gmail App Password (NOT your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
# Enable 2FA on your Google account first
EMAIL_PASS=

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Debug mode (true/false) - enables detailed error messages
DEBUG=false

# Backend port (default: 8000)
PORT=8000

# CORS origins (comma-separated list of allowed frontend URLs)
# Default allows all origins (*) - restrict in production
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. After filling in your credentials, rename this file to just ".env"
#    (remove the ".example" extension)
#
# 2. For Gmail SMTP to work:
#    - Enable 2-Factor Authentication on your Google account
#    - Generate an "App Password" at myaccount.google.com/apppasswords
#    - Use that 16-character password in EMAIL_PASS (not your regular password)
#
# 3. For production deployment:
#    - Switch to PostgreSQL database
#    - Restrict CORS_ORIGINS to your actual frontend domain
#    - Set DEBUG=false
#    - Use strong, unique API keys
#
# 4. To test the backend:
#    cd backend
#    uvicorn main:app --reload --port 8000
#
# =============================================================================
